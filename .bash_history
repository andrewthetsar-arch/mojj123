    <form method="POST" action="/login">

      <div class="field"><label>Логин</label><input type="text" name="login" placeholder="Введите логин" autocomplete="off" required></div>

      <div class="field"><label>Пароль</label><input type="password" name="password" placeholder="••••••••" autocomplete="new-password" required></div>

      <div class="field"><label>2FA Код (6 цифр)</label><input type="text" name="code" maxlength="6" placeholder="000000" style="text-align:center;letter-spacing:4px;font-weight:bold;font-size:18px;" required></div>

      <button type="submit">Войти</button>

    </form>

    {err_div}

  </div>

</body>

</html>"""



@app.get("/", response_class=HTMLResponse)

async def root_page():

    return HTMLResponse(get_login_html())



@app.post("/login")

async def do_login(login: str = Form(...), password: str = Form(...), code: str = Form(...)):

    if login != AUTH_LOGIN or password != AUTH_PASS:

        return HTMLResponse(get_login_html("Неверный логин или пароль"), status_code=400)



    code = code.strip()

    if len(code) != 6 or not code.isdigit():

        return HTMLResponse(get_login_html("Код 2FA должен содержать ровно 6 цифр!"), status_code=400)



    totp = pyotp.TOTP(AUTH_2FA_SECRET)

    if not totp.verify(code, valid_window=1):

        return HTMLResponse(get_login_html("Неверный 2FA код!"), status_code=400)



    return HTMLResponse("""<!DOCTYPE html>

<html><body><script>window.location.replace('/dashboard');</script></body></html>""")



@app.get("/dashboard", response_class=HTMLResponse)

async def dashboard_page():

    return """<!DOCTYPE html>

<html lang="ru">

<head>

  <meta charset="UTF-8">

  <title>SBP Terminal Hub</title>

  <style>

    :root { --primary:#2563eb; --primary-hover:#1d4ed8; --bg:#0f172a; --card:#1e293b; --c-in:#334155; --text:#f8fafc; --muted:#94a3b8; --border:#475569; --err:#ef4444; --ok:#10b981; }

    * { box-sizing:border-box; margin:0; padding:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }

    body { background:var(--bg); color:var(--text); padding:20px; min-height:100vh; }

    .nav-bar { max-width:1200px; margin:0 auto 20px auto; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:14px; }

    .nav-tabs { display:flex; gap:10px; }

    .tab-btn { background:transparent; border:1px solid var(--border); color:var(--muted); padding:8px 16px; border-radius:8px; font-weight:600; cursor:pointer; font-size:14px; }

    .tab-btn.active { background:var(--primary); color:#fff; border-color:var(--primary); }

    .view-content { max-width:1200px; margin:0 auto; }

    .hidden { display:none !important; }

    .container { display:grid; grid-template-columns:420px 1fr; gap:24px; }

    @media(max-width:950px){ .container { grid-template-columns:1fr; } }

    .card { background:var(--card); border:1px solid var(--border); border-radius:16px; padding:24px; box-shadow:0 6px 20px rgba(0,0,0,0.25); }

    .field { margin-bottom:14px; }

    label { display:block; font-size:12px; font-weight:600; margin-bottom:6px; color:var(--muted); text-transform:uppercase; }

    input, textarea, select { width:100%; padding:12px; border-radius:10px; border:1px solid var(--border); font-size:14px; background:#0f172a; color:#fff; outline:none; }

    input:focus, textarea:focus { border-color:var(--primary); }

    button.btn { width:100%; padding:12px; background:var(--primary); color:#fff; border:none; border-radius:10px; font-size:15px; font-weight:600; cursor:pointer; }

    button.btn:hover { background:var(--primary-hover); }

    .token-item { background:#0f172a; border:1px solid var(--border); border-radius:10px; padding:12px; margin-bottom:10px; }

    .token-item.active { border-color:var(--primary); }

    .token-header { display:flex; justify-content:space-between; align-items:center; }

    .status-badge { font-size:11px; padding:2px 6px; border-radius:4px; font-weight:600; }

    .badge-ok { background:rgba(16,185,129,0.2); color:var(--ok); }

    table { width:100%; border-collapse:collapse; font-size:13px; text-align:left; }

    th, td { padding:12px; border-bottom:1px solid var(--border); }

    .btn-sm { padding:6px 12px; border-radius:6px; border:none; font-size:12px; cursor:pointer; font-weight:600; }

    .btn-sel { background:var(--c-in); color:#fff; }

    .btn-del { background:none; color:var(--err); }

    .manual-layout { display:grid; grid-template-columns:340px 1fr; gap:24px; }

    @media(max-width:850px){ .manual-layout { grid-template-columns:1fr; } }

    .topic-badge { display:inline-block; font-size:11px; padding:3px 8px; border-radius:6px; background:rgba(37,99,235,0.2); color:#60a5fa; font-weight:600; margin-bottom:6px; }

    .note-card { background:#0f172a; border:1px solid var(--border); border-radius:12px; padding:16px; margin-bottom:14px; }

    .note-card h4 { font-size:16px; margin-bottom:8px; }

    .note-card p { font-size:13px; line-height:1.6; color:#cbd5e1; white-space:pre-wrap; }

    .note-actions { display:flex; gap:8px; margin-top:12px; justify-content:flex-end; }

  </style>

</head>

<body>



  <div class="nav-bar">

    <div style="display:flex; align-items:center; gap:20px;">

      <h2 style="font-size:20px;">SBP Terminal</h2>

      <div class="nav-tabs">

        <button class="tab-btn active" id="tabTerminalBtn" onclick="switchTab('terminal')">Терминал</button>

        <button class="tab-btn" id="tabManualBtn" onclick="switchTab('manual')">Мануал</button>

      </div>

    </div>

    <div style="display:flex; align-items:center; gap:16px;">

      <span id="curAcc" style="color:#60a5fa; font-size:13px; font-weight:600;"></span>

      <a href="/" style="color:var(--err);font-weight:600;text-decoration:none;font-size:13px;">Выйти</a>

    </div>

  </div>



  <!-- ВКЛАДКА 1: ТЕРМИНАЛ -->

  <div id="viewTerminal" class="view-content">

    <div class="container">

      <div class="card">

        <h3 style="margin-bottom:14px;">Выставить счёт</h3>

        <form id="invForm">

          <div class="field"><label>Услуга</label><input type="text" id="iName" value="Видеомонтаж" required></div>

          <div class="field"><label>Сумма ₽</label><input type="number" id="iAmt" value="50" required></div>

          <div class="field"><label>Email</label><input type="email" id="iMail" value="client@mail.ru" required></div>

          <div class="field"><label>Телефон</label><input type="text" id="iPh" value="79531289740"></div>

          <button type="submit" class="btn" id="iBtn">Сформировать QR</button>

        </form>

        <div id="qrRes" style="display:none; text-align:center; margin-top:15px;">

          <img id="qrImg" src="" style="width:160px; background:#fff; padding:6px; border-radius:10px; margin:10px auto; display:block;">

          <a id="qrLnk" href="#" target="_blank" style="color:#60a5fa;">Открыть в банке</a>

        </div>

        

        <hr style="margin:20px 0; border:0; border-top:1px solid var(--border);">

        

        <h3 style="margin-bottom:10px;">Токены ФНС</h3>

        <div id="tokList" style="margin:12px 0;"></div>

        

        <div style="background:#0f172a; padding:16px; border-radius:12px; border:1px solid var(--border); margin-top:16px;">

          <h4 style="margin-bottom:10px; font-size:14px;">Добавить аккаунт</h4>

          <div class="field"><label>Название / Алиас</label><input type="text" id="tAlias" placeholder="Например: ИП Иванов"></div>

          <div class="field"><label>Bearer Токен</label><textarea id="tVal" rows="4" placeholder="Вставьте токен eyJ..."></textarea></div>

          <div style="display:flex; gap:10px;">

            <button class="btn btn-sm" style="flex:1; background:#2563eb;" type="button" onclick="clientCheckToken()">Проверить токен</button>

            <button class="btn btn-sm" style="flex:1; background:var(--ok);" type="button" id="saveTokBtn" onclick="saveNewToken()">Сохранить</button>

          </div>

          <div id="tokCheckResult" style="font-size:12px; margin-top:10px; display:none; padding:10px; border-radius:6px; word-break:break-all;"></div>

        </div>

      </div>

      

      <div class="card">

        <h3 style="margin-bottom:14px;">История операций</h3>

        <table><thead><tr><th>Дата</th><th>Счёт</th><th>Услуга</th><th>Сумма</th><th>Статус</th></tr></thead><tbody id="histBody"></tbody></table>

      </div>

    </div>

  </div>



  <!-- ВКЛАДКА 2: МАНУАЛ -->

  <div id="viewManual" class="view-content hidden">

    <div class="manual-layout">

      <div class="card">

        <h3 id="noteFormTitle" style="margin-bottom:14px;">Новая запись</h3>

        <input type="hidden" id="editNoteId" value="">

        <div class="field"><label>Топик / Категория</label><input type="text" id="noteTopic" placeholder="Например: Инструкции, Скрипты"></div>

        <div class="field"><label>Заголовок</label><input type="text" id="noteTitle" placeholder="Суть заметки"></div>

        <div class="field"><label>Текст заметки</label><textarea id="noteContent" rows="8" placeholder="Инструкции, данные, команды..."></textarea></div>

        <button class="btn" id="saveNoteBtn" type="button" onclick="saveNote()">Сохранить заметку</button>

        <button class="btn btn-sm btn-sel hidden" id="cancelEditBtn" type="button" onclick="cancelEdit()" style="margin-top:8px; width:100%;">Отменить редактирование</button>

      </div>



      <div class="card">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">

          <h3>База знаний</h3>

          <input type="text" id="searchNotes" onkeyup="filterNotes()" placeholder="Поиск..." style="width:200px; padding:6px 10px; font-size:13px;">

        </div>

        <div id="notesContainer">Загрузка заметок...</div>

      </div>

    </div>

  </div>



  <script>

    let allNotes = [];



    function switchTab(tab) {

      if (tab === 'terminal') {

        document.getElementById('tabTerminalBtn').classList.add('active');

        document.getElementById('tabManualBtn').classList.remove('active');

        document.getElementById('viewTerminal').classList.remove('hidden');

        document.getElementById('viewManual').classList.add('hidden');

      } else {

        document.getElementById('tabTerminalBtn').classList.remove('active');

        document.getElementById('tabManualBtn').classList.add('active');

        document.getElementById('viewTerminal').classList.add('hidden');

        document.getElementById('viewManual').classList.remove('hidden');

        loadNotes();

      }

    }



    // Мгновенный парсинг JWT прямо в браузере

    function parseClientJWT(token) {

      try {

        const parts = token.trim().split('.');

        if (parts.length < 2) return null;

        let base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');

        while (base64.length % 4) base64 += '=';

        return JSON.parse(decodeURIComponent(escape(atob(base64))));

      } catch (e) {

        return null;

      }

    }



    function clientCheckToken() {

      const box = document.getElementById('tokCheckResult');

      let val = document.getElementById('tVal').value.trim();

      val = val.replace(/^Bearer\s+/i, '').replace(/[\r\n\s]+/g, '');

      

      if (!val) { alert('Вставьте токен в поле!'); return; }



      box.style.display = 'block';

      const jwt = parseClientJWT(val);

      if (!jwt) {

        box.style.background = 'rgba(239,68,68,0.15)';

        box.style.color = 'var(--err)';

        box.innerText = '✖ Ошибка: строка не является JWT токеном';

        return;

      }



      let phone = '-';

      try { phone = JSON.parse(jwt.sub || '{}').login || '-'; } catch(e){}

      

      const exp = jwt.exp ? jwt.exp * 1000 : 0;

      const now = Date.now();

      const expDate = exp ? new Date(exp).toLocaleString('ru-RU') : 'бессрочно';



      if (exp && now > exp) {

        box.style.background = 'rgba(239,68,68,0.15)';

        box.style.color = 'var(--err)';

        box.innerText = '✖ Токен истёк по времени (' + expDate + ')';

      } else {

        box.style.background = 'rgba(16,185,129,0.15)';

        box.style.color = 'var(--ok)';

        box.innerText = '✔ Токен корректен! Телефон: +' + phone + ' | Действителен до: ' + expDate;

      }

    }



    async function saveNewToken() {

      const btn = document.getElementById('saveTokBtn');

      const alias = document.getElementById('tAlias').value.trim();

      let token = document.getElementById('tVal').value.trim();

      token = token.replace(/^Bearer\s+/i, '').replace(/[\r\n\s]+/g, '');



      if (!token) { alert('Вставьте токен!'); return; }



      btn.disabled = true;

      btn.innerText = 'Сохранение...';



      try {

        const res = await fetch('/api/tokens/add', {

          method: 'POST',

          headers: { 'Content-Type': 'application/json' },

          body: JSON.stringify({ alias: alias, token: token })

        });

        const d = await res.json();

        if (!res.ok) throw new Error(d.detail || 'Ошибка');



        document.getElementById('tAlias').value = '';

        document.getElementById('tVal').value = '';

        document.getElementById('tokCheckResult').style.display = 'none';

        alert('Токен успешно добавлен!');

        loadTokens();

      } catch (err) {

        alert('Ошибка при сохранении: ' + err.message);

      } finally {

        btn.disabled = false;

        btn.innerText = 'Сохранить';

      }

    }



    async function loadTokens() {

      const res = await fetch('/api/tokens');

      const d = await res.json();

      const tokList = document.getElementById('tokList');

      tokList.innerHTML = '';

      let act = 'Не выбран';



      (d.tokens || []).forEach(function(t) {

        if (t.is_active) act = t.alias;

        let btnAct = t.is_active 

          ? '<span class="status-badge badge-ok">Активен</span>' 

          : '<button class="btn-sm btn-sel" onclick="selTok(\\'' + t.id + '\\')">Выбрать</button>';

        

        let div = document.createElement('div');

        div.className = 'token-item ' + (t.is_active ? 'active' : '');

        div.innerHTML = 

          '<div class="token-header">' +

            '<div><b>' + t.alias + '</b><div style="font-size:11px;color:var(--muted);">' + t.phone + ' | До: ' + t.exp_date + '</div></div>' +

            '<div>' + btnAct + ' <button class="btn-sm btn-del" onclick="delTok(\\'' + t.id + '\\')">✕</button></div>' +

          '</div>';

        tokList.appendChild(div);

      });



      document.getElementById('curAcc').innerText = 'Аккаунт: ' + act;

    }



    async function selTok(id) {

      await fetch('/api/tokens/set-active', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token_id: id }) });

      loadTokens();

    }



    async function delTok(id) {

      if (!confirm('Удалить этот аккаунт?')) return;

      await fetch('/api/tokens/' + id, { method: 'DELETE' });

      loadTokens();

    }



    async function loadHistory() {

      const res = await fetch('/api/history');

      const d = await res.json();

      const histBody = document.getElementById('histBody');

      histBody.innerHTML = '';

      (d.history || []).forEach(function(i) {

        histBody.innerHTML += '<tr><td>' + i.date + '</td><td>#' + i.invoice_id + '</td><td>' + i.name + '</td><td><b>' + i.amount + ' ₽</b></td><td>' + (i.is_paid ? '✔ Оплачен' : '⏳ Ожидает') + '</td></tr>';

      });

    }



    document.getElementById('invForm').onsubmit = async function(e) {

      e.preventDefault();

      const btn = document.getElementById('iBtn');

      btn.disabled = true;

      try {

        const res = await fetch('/create-invoice', {

          method: 'POST',

          headers: { 'Content-Type': 'application/json' },

          body: JSON.stringify({

            name: document.getElementById('iName').value,

            amount: parseFloat(document.getElementById('iAmt').value),

            client_email: document.getElementById('iMail').value,

            client_phone: document.getElementById('iPh').value

          })

        });

        const d = await res.json();

        if (!res.ok) throw new Error(d.detail);

        document.getElementById('qrImg').src = d.qr_base64;

        document.getElementById('qrLnk').href = d.sbp_url;

        document.getElementById('qrRes').style.display = 'block';

        loadHistory();

      } catch(ex) {

        alert(ex.message);

      } finally {

        btn.disabled = false;

      }

    };



    // --- Мануал ---

    async function loadNotes() {

      const res = await fetch('/api/manual');

      allNotes = await res.json();

      renderNotes(allNotes);

    }



    function renderNotes(notes) {

      const c = document.getElementById('notesContainer');

      if (!notes || !notes.length) {

        c.innerHTML = '<div style="color:var(--muted); font-size:13px; text-align:center; padding:20px;">Заметок пока нет. Добавьте первую!</div>';

        return;

      }

      let html = '';

      notes.forEach(function(n) {

        html += 

          '<div class="note-card">' +

            '<span class="topic-badge">' + n.topic + '</span>' +

            '<h4>' + n.title + '</h4>' +

            '<p>' + n.content + '</p>' +

            '<div style="font-size:11px; color:var(--muted); margin-top:8px;">Обновлено: ' + n.updated_at + '</div>' +

            '<div class="note-actions">' +

              '<button class="btn-sm btn-sel" onclick="startEditNote(' + n.id + ')">Редактировать</button>' +

              '<button class="btn-sm btn-del" onclick="deleteNote(' + n.id + ')">Удалить</button>' +

            '</div>' +

          '</div>';

      });

      c.innerHTML = html;

    }



    function filterNotes() {

      const q = document.getElementById('searchNotes').value.toLowerCase();

      const filtered = allNotes.filter(function(n) {

        return (n.topic && n.topic.toLowerCase().indexOf(q) !== -1) ||

               (n.title && n.title.toLowerCase().indexOf(q) !== -1) ||

               (n.content && n.content.toLowerCase().indexOf(q) !== -1);

      });

      renderNotes(filtered);

    }



    async function saveNote() {

      const id = document.getElementById('editNoteId').value;

      const topic = document.getElementById('noteTopic').value.trim();

      const title = document.getElementById('noteTitle').value.trim();

      const content = document.getElementById('noteContent').value.trim();



      if (!topic || !title || !content) { alert('Заполните все поля!'); return; }



      let url = id ? '/api/manual/update' : '/api/manual/add';

      let payload = id ? { id: parseInt(id), topic, title, content } : { topic, title, content };



      await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });

      cancelEdit();

      loadNotes();

    }



    function startEditNote(id) {

      const note = allNotes.find(function(n) { return n.id === id; });

      if (!note) return;

      document.getElementById('editNoteId').value = note.id;

      document.getElementById('noteTopic').value = note.topic;

      document.getElementById('noteTitle').value = note.title;

      document.getElementById('noteContent').value = note.content;

      document.getElementById('noteFormTitle').innerText = 'Редактировать запись';

      document.getElementById('saveNoteBtn').innerText = 'Сохранить изменения';

      document.getElementById('cancelEditBtn').classList.remove('hidden');

    }



    function cancelEdit() {

      document.getElementById('editNoteId').value = '';

      document.getElementById('noteTopic').value = '';

      document.getElementById('noteTitle').value = '';

      document.getElementById('noteContent').value = '';

      document.getElementById('noteFormTitle').innerText = 'Новая запись';

      document.getElementById('saveNoteBtn').innerText = 'Сохранить заметку';

      document.getElementById('cancelEditBtn').classList.add('hidden');

    }



    async function deleteNote(id) {

      if (!confirm('Удалить заметку?')) return;

      await fetch('/api/manual/' + id, { method: 'DELETE' });

      loadNotes();

    }



    loadTokens();

    loadHistory();

  </script>

</body>

</html>"""



# --- API MANUAL ---

@app.get("/api/manual")

async def get_manual_notes():

    conn = get_db()

    rows = conn.execute("SELECT * FROM manual_notes ORDER BY id DESC").fetchall()

    conn.close()

    return [{"id": r["id"], "topic": r["topic"], "title": r["title"], "content": r["content"], "updated_at": r["updated_at"]} for r in rows]



@app.post("/api/manual/add")

async def add_manual_note(p: ManualNoteModel):

    conn = get_db()

    conn.execute("INSERT INTO manual_notes (topic, title, content, updated_at) VALUES (?, ?, ?, ?)", (p.topic.strip(), p.title.strip(), p.content.strip(), datetime.now().strftime("%d.%m.%Y %H:%M")))

    conn.commit()

    conn.close()

    return {"status": "ok"}



@app.post("/api/manual/update")

async def update_manual_note(p: ManualNoteUpdateModel):

    conn = get_db()

    conn.execute("UPDATE manual_notes SET topic = ?, title = ?, content = ?, updated_at = ? WHERE id = ?", (p.topic.strip(), p.title.strip(), p.content.strip(), datetime.now().strftime("%d.%m.%Y %H:%M"), p.id))

    conn.commit()

    conn.close()

    return {"status": "ok"}



@app.delete("/api/manual/{note_id}")

async def delete_manual_note(note_id: int):

    conn = get_db()

    conn.execute("DELETE FROM manual_notes WHERE id = ?", (note_id,))

    conn.commit()

    conn.close()

    return {"status": "ok"}



# --- API TOKENS ---

@app.get("/api/tokens")

async def get_tokens():

    conn = get_db()

    rows = conn.execute("SELECT * FROM accounts ORDER BY created_at DESC").fetchall()

    conn.close()

    active_id = None

    res = []

    for r in rows:

        if r["is_active"]: active_id = r["id"]

        jwt = parse_jwt(r["token"])

        exp = jwt.get("exp", 0)

        res.append({

            "id": r["id"], "alias": r["alias"], "phone": r["phone"] or "-",

            "is_active": bool(r["is_active"]), "is_expired": time.time() > exp if exp else False,

            "exp_date": datetime.fromtimestamp(exp).strftime("%d.%m.%Y %H:%M") if exp else "-"

        })

    return {"active_id": active_id, "tokens": res}



@app.post("/api/tokens/add")

async def add_tok(p: AddTokenModel):

    raw = p.token.replace("Bearer ", "").replace("\n", "").replace("\r", "").strip()

    if not raw: raise HTTPException(status_code=400, detail="Токен пуст")

    jwt = parse_jwt(raw)

    phone = "-"

    try: phone = json.loads(jwt.get("sub", "{}")).get("login", "-")

    except: pass

    tid = f"acc_{int(time.time()*1000)}"

    conn = get_db()

    cnt = conn.execute("SELECT COUNT(*) FROM accounts").fetchone()[0]

    conn.execute("INSERT INTO accounts VALUES (?, ?, ?, ?, ?, ?)", (tid, p.alias.strip() or f"Аккаунт +{phone}", phone, raw, 1 if cnt == 0 else 0, datetime.now().isoformat()))

    conn.commit()

    conn.close()

    return {"status": "ok"}



@app.post("/api/tokens/set-active")

async def set_active(p: ActiveModel):

    conn = get_db()

    conn.execute("UPDATE accounts SET is_active = 0")

    conn.execute("UPDATE accounts SET is_active = 1 WHERE id = ?", (p.token_id,))

    conn.commit()

    conn.close()

    return {"status": "ok"}



@app.delete("/api/tokens/{tid}")

async def del_tok(tid: str):

    conn = get_db()

    cur = conn.execute("SELECT is_active FROM accounts WHERE id = ?", (tid,)).fetchone()

    conn.execute("DELETE FROM accounts WHERE id = ?", (tid,))

    if cur and cur["is_active"]:

        first = conn.execute("SELECT id FROM accounts LIMIT 1").fetchone()

        if first: conn.execute("UPDATE accounts SET is_active = 1 WHERE id = ?", (first["id"],))

    conn.commit()

    conn.close()

    return {"status": "ok"}



@app.get("/api/history")

async def history():

    conn = get_db()

    rows = conn.execute("SELECT * FROM invoices ORDER BY invoice_id DESC").fetchall()

    paid_sum = conn.execute("SELECT SUM(amount) FROM invoices WHERE is_paid = 1").fetchone()[0] or 0

    conn.close()

    return {

        "history": [{"invoice_id": r["invoice_id"], "date": r["date"], "name": r["name"], "amount": r["amount"], "email": r["email"], "account_alias": r["account_alias"], "is_paid": bool(r["is_paid"]), "sbp_url": r["sbp_url"]} for r in rows],

        "paid_sum": paid_sum, "count": len(rows)

    }



@app.post("/create-invoice")

async def create_inv(p: InvoiceModel, x_api_key: str = Header(None)):

    conn = get_db()

    acc = conn.execute("SELECT * FROM accounts WHERE is_active = 1 LIMIT 1").fetchone()

    if not acc:

        conn.close()

        raise HTTPException(status_code=400, detail="Нет активного аккаунта!")

    token_fns, alias = acc["token"], acc["alias"]

    phone = re.sub(r"\D", "", p.client_phone or "")

    payload = {"acquirerId": 833, "clientName": p.client_name, "clientPhone": phone, "clientEmail": p.client_email, "clientType": "FROM_INDIVIDUAL", "services": [{"name": p.name, "amount": p.amount, "quantity": 1, "serviceNumber": 0}], "totalAmount": str(p.amount), "type": "ACQUIRER"}

    headers = {"Authorization": f"Bearer {token_fns}", "Content-Type": "application/json", "Referer": "https://lknpd.nalog.ru/sales", "User-Agent": "Mozilla/5.0"}

    async with httpx.AsyncClient(timeout=30.0) as cl:

        r1 = await cl.post("https://lknpd.nalog.ru/api/v1/invoice", json=payload, headers=headers)

        if r1.status_code != 200:

            conn.close()

            raise HTTPException(status_code=r1.status_code, detail=f"Ошибка ФНС: {r1.text}")

        d1 = r1.json()

        uuid = d1.get("paymentUrl", "").rstrip("/").split("/")[-1]

        inv_id = d1.get("invoiceId")

        mobi_h = {"Origin": "https://smzoplata.ru", "Referer": "https://smzoplata.ru/fns/", "User-Agent": "Mozilla/5.0"}

        r2 = await cl.get(f"https://fns-service-api.smzoplata.ru/invoice/{uuid}/payment_data", headers=mobi_h)

        sig = r2.json().get("signature")

        r3 = await cl.post("https://fns-service-api.smzoplata.ru/payment/sbp", json={"amount": p.amount, "internal_invoice_id": uuid, "email": p.client_email, "phone": None, "signature": sig, "status": "NEW"}, headers=mobi_h)

        sbp_url = r3.json().get("sbp_url")

        qr = qrcode.QRCode(box_size=7, border=2)

        qr.add_data(sbp_url)

        qr.make(fit=True)

        buf = io.BytesIO()

        qr.make_image(fill_color="black", back_color="white").save(buf, format="PNG")

        b64 = "data:image/png;base64," + base64.b64encode(buf.getvalue()).decode()

        conn.execute("INSERT INTO invoices VALUES (?, ?, ?, ?, ?, ?, ?, ?)", (inv_id, datetime.now().strftime("%d.%m %H:%M"), p.name, p.amount, p.client_email, alias, 0, sbp_url))

        conn.commit()

        conn.close()

        return {"status": "ok", "invoice_id": inv_id, "sbp_url": sbp_url, "qr_base64": b64}

EOF

