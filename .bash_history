from datetime import datetime

import httpx, qrcode, pyotp

from fastapi import FastAPI, HTTPException, Header, Request, Form

from fastapi.responses import HTMLResponse, FileResponse

from pydantic import BaseModel



app = FastAPI()

DB_FILE = "/home/c/cc361963/public_html/database.sqlite"

HTML_FILE = "/home/c/cc361963/public_html/dashboard.html"

API_KEY = "my_secret_token_123"



AUTH_LOGIN = "jopa"

AUTH_PASS = "qrnspkmeow"

AUTH_2FA_SECRET = "33QXNNYICMQA6J7J"



def init_db():

    conn = sqlite3.connect(DB_FILE)

    cur = conn.cursor()

    cur.execute("""

        CREATE TABLE IF NOT EXISTS accounts (

            id TEXT PRIMARY KEY,

            alias TEXT,

            phone TEXT,

            token TEXT,

            is_active INTEGER,

            created_at TEXT

        )

    """)

    try:

        cur.execute("ALTER TABLE accounts ADD COLUMN refresh_token TEXT DEFAULT ''")

    except:

        pass

    cur.execute("""

        CREATE TABLE IF NOT EXISTS invoices (

            invoice_id INTEGER PRIMARY KEY,

            date TEXT,

            name TEXT,

            amount REAL,

            email TEXT,

            account_alias TEXT,

            is_paid INTEGER,

            sbp_url TEXT

        )

    """)

    cur.execute("""

        CREATE TABLE IF NOT EXISTS manual_notes (

            id INTEGER PRIMARY KEY AUTOINCREMENT,

            topic TEXT NOT NULL,

            title TEXT NOT NULL,

            content TEXT NOT NULL,

            updated_at TEXT

        )

    """)

    conn.commit()

    conn.close()



init_db()



def get_db():

    conn = sqlite3.connect(DB_FILE)

    conn.row_factory = sqlite3.Row

    return conn



def parse_jwt(token: str) -> dict:

    try:

        parts = token.strip().split(".")

        if len(parts) >= 2:

            rem = len(parts[1]) % 4

            b64 = parts[1] + ("=" * (4 - rem) if rem else "")

            return json.loads(base64.urlsafe_b64decode(b64.encode()).decode("utf-8", errors="ignore"))

    except:

        pass

    return {}



async def refresh_fns_session(account_id: str) -> str:

    conn = get_db()

    acc = conn.execute("SELECT * FROM accounts WHERE id = ?", (account_id,)).fetchone()

    if not acc:

        conn.close()

        raise HTTPException(status_code=404, detail="Аккаунт не найден")

    

    ref_tok = (acc["refresh_token"] or "").strip()

    if not ref_tok:

        conn.close()

        raise HTTPException(status_code=400, detail="У аккаунта нет Refresh токена для автопродления")



    payload = {

        "deviceInfo": {

            "appVersion": "1.0.0",

            "sourceDeviceId": "web_terminal_" + account_id[:8],

            "sourceType": "WEB"

        },

        "refreshToken": ref_tok

    }

    headers = {

        "Accept": "application/json, text/plain, */*",

        "Content-Type": "application/json",

        "Referer": "https://lknpd.nalog.ru/",

        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

    }



    async with httpx.AsyncClient(timeout=20.0) as client:

        resp = await client.post("https://lknpd.nalog.ru/api/v1/auth/token", json=payload, headers=headers)

        if resp.status_code != 200:

            conn.close()

            raise HTTPException(status_code=400, detail=f"Ошибка продления ФНС: {resp.text[:120]}")

        

        data = resp.json()

        new_token = data.get("token")

        new_ref = data.get("refreshToken", ref_tok)



        if not new_token:

            conn.close()

            raise HTTPException(status_code=400, detail="ФНС не вернул новый токен")



        conn.execute("UPDATE accounts SET token = ?, refresh_token = ? WHERE id = ?", (new_token, new_ref, account_id))

        conn.commit()

        conn.close()

        return new_token



async def get_valid_token(account_id: str) -> str:

    conn = get_db()

    acc = conn.execute("SELECT * FROM accounts WHERE id = ?", (account_id,)).fetchone()

    conn.close()

    if not acc:

        raise HTTPException(status_code=404, detail="Аккаунт не найден")

    

    token = acc["token"]

    jwt = parse_jwt(token)

    exp = jwt.get("exp", 0)



    # Если до конца токена меньше 5 минут или он протух, но есть refresh_token — обновляем

    if exp and (time.time() >= exp - 300) and acc["refresh_token"]:

        try:

            return await refresh_fns_session(account_id)

        except Exception as e:

            print(f"Ошибка автопродления: {e}")

            return token

    return token



