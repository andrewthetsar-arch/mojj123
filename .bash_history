import os, re, json, io, base64, time, sqlite3, secrets

from datetime import datetime

import httpx, qrcode, pyotp

from fastapi import FastAPI, HTTPException, Header, Request, Depends, status

from fastapi.security import HTTPBasic, HTTPBasicCredentials

from fastapi.responses import HTMLResponse

from pydantic import BaseModel



app = FastAPI()

security = HTTPBasic()



DB_FILE = "/home/c/cc361963/public_html/database.sqlite"

API_KEY = "my_secret_token_123"



AUTH_LOGIN = "jopa"

AUTH_PASS = "qrnspkmeow"

AUTH_2FA_SECRET = "33QXNNYICMQA6J7J"



def init_db():

    conn = sqlite3.connect(DB_FILE)

    cur = conn.cursor()

    cur.execute("CREATE TABLE IF NOT EXISTS accounts (id TEXT PRIMARY KEY, alias TEXT, phone TEXT, token TEXT, is_active INTEGER, created_at TEXT)")

    cur.execute("CREATE TABLE IF NOT EXISTS invoices (invoice_id INTEGER PRIMARY KEY, date TEXT, name TEXT, amount REAL, email TEXT, account_alias TEXT, is_paid INTEGER, sbp_url TEXT)")

    conn.commit()

    conn.close()



init_db()



def get_db():

    conn = sqlite3.connect(DB_FILE)

    conn.row_factory = sqlite3.Row

    return conn



def parse_jwt(token: str) -> dict:

    try:

        parts = token.split(".")

        if len(parts) >= 2:

            return json.loads(base64.urlsafe_b64decode(parts[1] + "==").decode())

    except:

        pass

    return {}



def authenticate(credentials: HTTPBasicCredentials = Depends(security)):

    if credentials.username != AUTH_LOGIN:

        raise HTTPException(

            status_code=status.HTTP_401_UNAUTHORIZED,

            detail="Неверный логин",

            headers={"WWW-Authenticate": "Basic"},

        )

    

    # Пароль должен заканчиваться ровно 6 цифрами 2FA: qrnspkmeow + 123456

    raw_pass = credentials.password

    if len(raw_pass) != len(AUTH_PASS) + 6:

        raise HTTPException(

            status_code=status.HTTP_401_UNAUTHORIZED,

            detail="Неверный формат пароля",

            headers={"WWW-Authenticate": "Basic"},

        )

    

    pass_part = raw_pass[:-6]

    code_part = raw_pass[-6:]

    

    if pass_part != AUTH_PASS or not code_part.isdigit():

        raise HTTPException(

            status_code=status.HTTP_401_UNAUTHORIZED,

            detail="Неверный пароль",

            headers={"WWW-Authenticate": "Basic"},

        )

        

    totp = pyotp.TOTP(AUTH_2FA_SECRET)

    if not totp.verify(code_part, valid_window=1):

        raise HTTPException(

            status_code=status.HTTP_401_UNAUTHORIZED,

            detail="Неверный 2FA код",

            headers={"WWW-Authenticate": "Basic"},

        )

    return credentials.username



