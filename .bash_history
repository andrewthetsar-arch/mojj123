import os, re, json, io, base64, time, sqlite3, secrets

from datetime import datetime

import httpx, qrcode, pyotp

from fastapi import FastAPI, HTTPException, Header, Request, Form

from fastapi.responses import HTMLResponse

from pydantic import BaseModel



app = FastAPI()

DB_FILE = "/home/c/cc361963/public_html/database.sqlite"

API_KEY = "my_secret_token_123"



AUTH_LOGIN = "jopa"

AUTH_PASS = "qrnspkmeow"

AUTH_2FA_SECRET = "33QXNNYICMQA6J7J"



def init_db():

    conn = sqlite3.connect(DB_FILE)

    cur = conn.cursor()

    cur.execute("""

        CREATE TABLE IF NOT EXISTS accounts (

            id TEXT PRIMARY KEY,

            alias TEXT,

            phone TEXT,

            token TEXT,

            is_active INTEGER,

            created_at TEXT

        )

    """)

    cur.execute("""

        CREATE TABLE IF NOT EXISTS invoices (

            invoice_id INTEGER PRIMARY KEY,

            date TEXT,

            name TEXT,

            amount REAL,

            email TEXT,

            account_alias TEXT,

            is_paid INTEGER,

            sbp_url TEXT

        )

    """)

    cur.execute("""

        CREATE TABLE IF NOT EXISTS manual_notes (

            id INTEGER PRIMARY KEY AUTOINCREMENT,

            topic TEXT NOT NULL,

            title TEXT NOT NULL,

            content TEXT NOT NULL,

            updated_at TEXT

        )

    """)

    cur.execute("""

        CREATE TABLE IF NOT EXISTS sessions (

            token TEXT PRIMARY KEY,

            created_at REAL

        )

    """)

    conn.commit()

    conn.close()



init_db()



def get_db():

    conn = sqlite3.connect(DB_FILE)

    conn.row_factory = sqlite3.Row

    return conn



def parse_jwt(token: str) -> dict:

    try:

        parts = token.strip().split(".")

        if len(parts) >= 2:

            rem = len(parts[1]) % 4

            b64 = parts[1] + ("=" * (4 - rem) if rem else "")

            return json.loads(base64.urlsafe_b64decode(b64.encode()).decode("utf-8", errors="ignore"))

    except:

        pass

    return {}



def check_token_auth(token_str: str) -> bool:

    if not token_str:

        return False

    clean = token_str.replace("Bearer ", "").strip()

    conn = get_db()

    row = conn.execute("SELECT token FROM sessions WHERE token = ?", (clean,)).fetchone()

    conn.close()

    return bool(row)



def get_req_auth(req: Request) -> str:

    # Ищем токен везде: в заголовке, в URL query, в теле

    auth = req.headers.get("Authorization", "").replace("Bearer ", "").strip()

    if not auth:

        auth = req.query_params.get("auth", "").strip()

    return auth



def verify_request(req: Request):

    token = get_req_auth(req)

    if not check_token_auth(token):

        raise HTTPException(status_code=401, detail="Unauthorized")

    return token



class InvoiceModel(BaseModel):

    name: str

    amount: float

    client_name: str = "Покупатель"

    client_phone: str = ""

    client_email: str

    auth_token: str = ""



class AddTokenModel(BaseModel):

