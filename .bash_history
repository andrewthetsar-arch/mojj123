cat << 'EOF' > app.py

import os

import re

import json

import io

import base64

import time

import sqlite3

from datetime import datetime

import httpx

import qrcode

from fastapi import FastAPI, HTTPException, Header

from fastapi.responses import HTMLResponse

from pydantic import BaseModel



app = FastAPI(title="Moy Nalog Multi-Account Hub")

DB_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "database.sqlite")

API_KEY = "my_secret_token_123"



def init_db():

    conn = sqlite3.connect(DB_FILE)

    cur = conn.cursor()

    cur.execute("""

        CREATE TABLE IF NOT EXISTS accounts (

            id TEXT PRIMARY KEY,

            alias TEXT NOT NULL,

            phone TEXT,

            token TEXT NOT NULL,

            is_active INTEGER DEFAULT 0,

            created_at TEXT

        )

    """)

    cur.execute("""

        CREATE TABLE IF NOT EXISTS invoices (

            invoice_id INTEGER PRIMARY KEY,

            date TEXT,

            name TEXT,

            amount REAL,

            email TEXT,

            account_alias TEXT,

            is_paid INTEGER DEFAULT 0,

            sbp_url TEXT

        )

    """)

    conn.commit()

    conn.close()



init_db()



def get_db():

    conn = sqlite3.connect(DB_FILE)

    conn.row_factory = sqlite3.Row

    return conn



def parse_jwt_payload(token: str) -> dict:

    try:

        parts = token.split(".")

        if len(parts) >= 2:

            padding = "=" * (4 - len(parts[1]) % 4)

            decoded = base64.urlsafe_b64decode(parts[1] + padding).decode("utf-8")

            return json.loads(decoded)

    except Exception:

        pass

    return {}



class InvoiceRequest(BaseModel):

    name: str

    amount: float

    client_name: str | None = "Покупатель"

    client_phone: str | None = ""

    client_email: str



class AddTokenRequest(BaseModel):

    alias: str

    token: str



class SetActiveRequest(BaseModel):

    token_id: str



class StatusUpdateRequest(BaseModel):

    invoice_id: int

    is_paid: bool



@app.get("/api/tokens")

async def get_tokens_list():

    conn = get_db()

    rows = conn.execute("SELECT * FROM accounts ORDER BY created_at DESC").fetchall()

    conn.close()



    active_id = None

    tokens_meta = []

    for r in rows:

        if r["is_active"]:

            active_id = r["id"]

        jwt = parse_jwt_payload(r["token"])

        exp = jwt.get("exp", 0)

        is_expired = time.time() > exp if exp else False

        tokens_meta.append({

            "id": r["id"],

            "alias": r["alias"],

            "phone": r["phone"] or "-",

            "is_active": bool(r["is_active"]),

            "is_expired": is_expired,

            "exp_date": datetime.fromtimestamp(exp).strftime("%d.%m.%Y %H:%M") if exp else "-"

        })

    return {"active_id": active_id, "tokens": tokens_meta}



@app.post("/api/tokens/add")

async def add_token(payload: AddTokenRequest):

    token_raw = payload.token.replace("Bearer ", "").strip()

    if not token_raw:

        raise HTTPException(status_code=400, detail="Токен пустой")



    jwt = parse_jwt_payload(token_raw)

    phone = "-"

    try:

        sub = json.loads(jwt.get("sub", "{}"))

        phone = sub.get("login", "-")

    except Exception:

        pass



    tid = f"acc_{int(time.time() * 1000)}"

    conn = get_db()

    count = conn.execute("SELECT COUNT(*) FROM accounts").fetchone()[0]

    is_active = 1 if count == 0 else 0



    conn.execute(

        "INSERT INTO accounts (id, alias, phone, token, is_active, created_at) VALUES (?, ?, ?, ?, ?, ?)",

        (tid, payload.alias.strip() or f"Аккаунт +{phone}", phone, token_raw, is_active, datetime.now().isoformat())

    )

    conn.commit()

    conn.close()

    return {"status": "ok", "id": tid}



@app.post("/api/tokens/set-active")

async def set_active_token(payload: SetActiveRequest):

    conn = get_db()

    conn.execute("UPDATE accounts SET is_active = 0")

    conn.execute("UPDATE accounts SET is_active = 1 WHERE id = ?", (payload.token_id,))

    conn.commit()

    conn.close()

    return {"status": "ok"}



@app.delete("/api/tokens/{token_id}")

async def delete_token(token_id: str):

    conn = get_db()

    target = conn.execute("SELECT is_active FROM accounts WHERE id = ?", (token_id,)).fetchone()

    conn.execute("DELETE FROM accounts WHERE id = ?", (token_id,))

    if target and target["is_active"]:

        first = conn.execute("SELECT id FROM accounts LIMIT 1").fetchone()

        if first:

            conn.execute("UPDATE accounts SET is_active = 1 WHERE id = ?", (first["id"],))

    conn.commit()

    conn.close()

    return {"status": "ok"}



@app.get("/api/history")

async def get_history():

    conn = get_db()

    rows = conn.execute("SELECT * FROM invoices ORDER BY invoice_id DESC").fetchall()

    paid_sum = conn.execute("SELECT SUM(amount) FROM invoices WHERE is_paid = 1").fetchone()[0] or 0

    conn.close()

    

    history = [

        {

            "invoice_id": r["invoice_id"],

            "date": r["date"],

            "name": r["name"],

            "amount": r["amount"],

            "email": r["email"],

            "account_alias": r["account_alias"],

            "is_paid": bool(r["is_paid"]),

            "sbp_url": r["sbp_url"]

        } for r in rows

    ]

    return {"history": history, "paid_sum": paid_sum, "count": len(history)}



@app.post("/api/history/status")

async def update_invoice_status(payload: StatusUpdateRequest):

    conn = get_db()

    conn.execute("UPDATE invoices SET is_paid = ? WHERE invoice_id = ?", (1 if payload.is_paid else 0, payload.invoice_id))

    conn.commit()

    conn.close()

    return {"status": "ok"}



@app.get("/", response_class=HTMLResponse)

async def dashboard_page():

    return """

    <!DOCTYPE html>

    <html lang="ru">

    <head>

      <meta charset="UTF-8">

      <meta name="viewport" content="width=device-width, initial-scale=1.0">

      <title>Панель управления платежами СБП</title>

      <style>

        :root {

          --primary: #2563eb;

          --primary-hover: #1d4ed8;

          --bg: #0f172a;

          --card: #1e293b;

          --card-inner: #334155;

          --text: #f8fafc;

          --text-muted: #94a3b8;

          --border: #475569;

          --success: #10b981;

          --danger: #ef4444;

          --warning: #f59e0b;

        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }

        body { background: var(--bg); color: var(--text); padding: 24px; min-height: 100vh; }

        .container { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 380px 1fr; gap: 24px; }

        @media (max-width: 900px) { .container { grid-template-columns: 1fr; } }

        

        .card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 24px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); }

        h1, h2 { font-size: 18px; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between; }

        

        .field { margin-bottom: 14px; }

        label { display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }

        input, select, textarea { width: 100%; padding: 12px 14px; border-radius: 10px; border: 1px solid var(--border); font-size: 14px; background: #0f172a; color: #fff; outline: none; }

        input:focus, textarea:focus { border-color: var(--primary); }

        textarea { resize: vertical; min-height: 80px; font-size: 12px; font-family: monospace; }

        

        button.btn { width: 100%; padding: 12px; background: var(--primary); color: #fff; border: none; border-radius: 10px; font-size: 15px; font-weight: 600; cursor: pointer; transition: 0.2s; }

        button.btn:hover { background: var(--primary-hover); }

        button.btn-sec { background: var(--card-inner); color: #fff; }

        button.btn-sec:hover { background: #475569; }

        

        .token-item { display: flex; align-items: center; justify-content: space-between; background: #0f172a; border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px; margin-bottom: 8px; font-size: 13px; }

        .token-item.active { border-color: var(--primary); background: rgba(37, 99, 235, 0.1); }

        .token-info { display: flex; flex-direction: column; gap: 2px; }

        .token-name { font-weight: 600; }

        .token-meta { font-size: 11px; color: var(--text-muted); }

        .token-actions { display: flex; gap: 6px; }

        .btn-sm { padding: 4px 8px; font-size: 12px; border-radius: 6px; border: none; cursor: pointer; }

        .btn-active { background: var(--primary); color: #fff; }

        .btn-del { background: transparent; color: var(--danger); }

        

        .stats-bar { display: flex; gap: 16px; margin-bottom: 24px; max-width: 1200px; margin-left: auto; margin-right: auto; }

        .stat-box { flex: 1; background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 18px; }

        .stat-val { font-size: 26px; font-weight: 700; color: var(--success); margin-top: 4px; }

        .stat-lbl { font-size: 13px; color: var(--text-muted); }



        table { width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; }

        th { padding: 12px; color: var(--text-muted); border-bottom: 1px solid var(--border); font-weight: 600; }

        td { padding: 14px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }

        .status-badge { display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 6px; font-weight: 600; font-size: 12px; cursor: pointer; user-select: none; }

        .status-badge.paid { background: rgba(16, 185, 129, 0.15); color: var(--success); border: 1px solid var(--success); }

        .status-badge.pending { background: rgba(245, 158, 11, 0.15); color: var(--warning); border: 1px solid var(--warning); }

        

        #resultBlock { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--border); text-align: center; display: none; }

        #qrImg { max-width: 170px; border-radius: 10px; background: #fff; padding: 6px; margin: 10px auto; display: block; }

        .link-copy { color: #60a5fa; word-break: break-all; font-size: 12px; cursor: pointer; text-decoration: underline; margin-top: 6px; }

      </style>

    </head>

    <body>

      <div style="max-width: 1200px; margin: 0 auto 20px auto; display: flex; justify-content: space-between; align-items: center;">

        <h1 style="font-size: 24px; margin: 0;">SBP Payment Terminal</h1>

        <div id="activeBadge" style="font-size: 13px; color: var(--text-muted);">Активный профиль: <span id="activeName" style="color: #60a5fa; font-weight: 600;">Не выбран</span></div>

      </div>



      <div class="stats-bar">

        <div class="stat-box">

          <div class="stat-lbl">Оплачено всего</div>

          <div class="stat-val" id="totalPaid">0 ₽</div>

        </div>

        <div class="stat-box">

          <div class="stat-lbl">Счетов выставлено</div>

          <div class="stat-val" style="color: #fff;" id="totalCount">0</div>

        </div>

      </div>



      <div class="container">

        <div style="display: flex; flex-direction: column; gap: 20px;">

          <div class="card">

            <h2>Выставить счёт</h2>

            <form id="createForm">

              <div class="field">

                <label>Услуга / Товар</label>

                <input type="text" id="svc_name" value="Видеомонтаж" required>

              </div>

              <div class="field">

                <label>Сумма (₽)</label>

                <input type="number" id="svc_amount" value="50" step="any" required>

              </div>

              <div class="field">

                <label>Email для чека</label>

                <input type="email" id="svc_email" value="client@mail.ru" required>

              </div>

              <div class="field">

                <label>Телефон клиента</label>

                <input type="text" id="svc_phone" value="79531289740">

              </div>

              <button type="submit" class="btn" id="btnSubmit">Сформировать QR СБП</button>

            </form>



            <div id="resultBlock">

              <div style="color: var(--success); font-weight: 600; font-size: 13px;">Счёт готов к оплате</div>

              <img id="qrImg" src="" alt="QR-код">

              <a id="bankLink" href="#" target="_blank" class="btn btn-sec" style="display: block; text-decoration: none; margin-top: 8px; font-size: 13px;">Открыть в банке</a>

              <div class="link-copy" id="copyUrl">Скопировать ссылку qr.nspk.ru</div>

            </div>

          </div>



          <div class="card">

            <h2>Токены ФНС</h2>

            <div id="tokensContainer" style="margin-bottom: 16px;"></div>



            <details>

              <summary style="font-size: 13px; color: var(--primary); cursor: pointer; font-weight: 600; margin-bottom: 10px;">+ Добавить новый аккаунт</summary>

              <div class="field">

                <label>Название / Метка</label>

                <input type="text" id="newTokenAlias" placeholder="Например: Основной / Запасной">

              </div>

              <div class="field">

                <label>Bearer-токен из DevTools</label>

                <textarea id="newTokenVal" placeholder="eyJhbGciOi..."></textarea>

              </div>

              <button class="btn btn-sec" onclick="submitToken()">Сохранить токен</button>

            </details>

          </div>

        </div>



        <div class="card" style="height: fit-content;">

          <h2>История операций</h2>

          <div style="overflow-x: auto;">

            <table>

              <thead>

                <tr>

                  <th>Дата</th>

                  <th>Счёт</th>

                  <th>Услуга / Email</th>

                  <th>Сумма</th>

                  <th>Аккаунт</th>

                  <th>Статус (клик для смены)</th>

                </tr>

              </thead>

              <tbody id="historyRows"></tbody>

            </table>

          </div>

        </div>

      </div>



      <script>

        let latestSbpUrl = '';



        async function loadTokens() {

          const res = await fetch('/api/tokens');

          const data = await res.json();

          const cont = document.getElementById('tokensContainer');

          cont.innerHTML = '';



          let activeAlias = 'Не выбран';



          data.tokens.forEach(t => {

            if (t.is_active) activeAlias = t.alias + ' (+' + t.phone + ')';

            const item = document.createElement('div');

            item.className = 'token-item ' + (t.is_active ? 'active' : '');

            item.innerHTML = `

              <div class="token-info">

                <div class="token-name">${t.alias} <span style="font-size:11px;color:${t.is_expired ? 'var(--danger)':'var(--success)'}">${t.is_expired ? '● Истёк' : '● Активен'}</span></div>

                <div class="token-meta">тел: +${t.phone} | до: ${t.exp_date}</div>

              </div>

              <div class="token-actions">

                ${!t.is_active ? `<button class="btn-sm btn-active" onclick="setActiveToken('${t.id}')">Выбрать</button>` : '<span style="font-size:12px;color:var(--primary);font-weight:600;">Активен</span>'}

                <button class="btn-sm btn-del" onclick="deleteToken('${t.id}')">✕</button>

              </div>

            `;

            cont.appendChild(item);

          });



          document.getElementById('activeName').innerText = activeAlias;

        }



        async function setActiveToken(id) {

          await fetch('/api/tokens/set-active', {

            method: 'POST',

            headers: {'Content-Type': 'application/json'},

            body: JSON.stringify({token_id: id})

          });

          loadTokens();

        }



        async function deleteToken(id) {

          if (!confirm('Удалить этот токен?')) return;

          await fetch('/api/tokens/' + id, { method: 'DELETE' });

          loadTokens();

        }



        async function submitToken() {

          const alias = document.getElementById('newTokenAlias').value.trim();

          const token = document.getElementById('newTokenVal').value.trim();

          if (!token) return alert('Вставьте токен!');



          await fetch('/api/tokens/add', {

            method: 'POST',

            headers: {'Content-Type': 'application/json'},

            body: JSON.stringify({alias, token})

          });



          document.getElementById('newTokenAlias').value = '';

          document.getElementById('newTokenVal').value = '';

          loadTokens();

        }



        async function loadHistory() {

          const res = await fetch('/api/history');

          const data = await res.json();

          document.getElementById('totalPaid').innerText = data.paid_sum.toLocaleString('ru-RU') + ' ₽';

          document.getElementById('totalCount').innerText = data.count;



          const rows = document.getElementById('historyRows');

          rows.innerHTML = '';



          data.history.forEach(item => {

            const tr = document.createElement('tr');

            tr.innerHTML = `

              <td style="color:var(--text-muted);">${item.date}</td>

              <td><b>#${item.invoice_id}</b></td>

              <td><div>${item.name}</div><div style="font-size:11px;color:var(--text-muted);">${item.email}</div></td>

              <td style="font-weight:700;">${item.amount} ₽</td>

              <td><span style="font-size:12px;color:var(--text-muted);">${item.account_alias}</span></td>

              <td>

                <span class="status-badge ${item.is_paid ? 'paid' : 'pending'}" onclick="toggleStatus(${item.invoice_id}, ${!item.is_paid})">

                  ${item.is_paid ? '✔ Оплачено' : '⏳ Ожидает'}

                </span>

              </td>

            `;

            rows.appendChild(tr);

          });

        }



        async function toggleStatus(invId, newStatus) {

          await fetch('/api/history/status', {

            method: 'POST',

            headers: {'Content-Type': 'application/json'},

            body: JSON.stringify({invoice_id: invId, is_paid: newStatus})

          });

          loadHistory();

        }



        document.getElementById('createForm').onsubmit = async (e) => {

          e.preventDefault();

          const btn = document.getElementById('btnSubmit');

          btn.disabled = true;

          btn.innerText = 'Создание...';



          const payload = {

            name: document.getElementById('svc_name').value,

            amount: parseFloat(document.getElementById('svc_amount').value),

            client_email: document.getElementById('svc_email').value,

            client_phone: document.getElementById('svc_phone').value,

            client_name: 'Покупатель'

          };



          try {

            const res = await fetch('/create-invoice', {

              method: 'POST',

              headers: {

                'Content-Type': 'application/json',

                'X-Api-Key': 'my_secret_token_123'

              },

              body: JSON.stringify(payload)

            });

            const data = await res.json();

            if (!res.ok) throw new Error(data.detail || 'Ошибка создания');



            latestSbpUrl = data.sbp_url;

            document.getElementById('qrImg').src = data.qr_base64;

            document.getElementById('bankLink').href = data.sbp_url;

            document.getElementById('resultBlock').style.display = 'block';



            loadHistory();

          } catch (err) {

            alert(err.message);

          } finally {

            btn.disabled = false;

            btn.innerText = 'Сформировать QR СБП';

          }

        };



        document.getElementById('copyUrl').onclick = () => {

          navigator.clipboard.writeText(latestSbpUrl);

          document.getElementById('copyUrl').innerText = 'Скопировано в буфер!';

          setTimeout(() => { document.getElementById('copyUrl').innerText = 'Скопировать ссылку qr.nspk.ru'; }, 2000);

        };



        loadTokens();

        loadHistory();

      </script>

    </body>

    </html>

    """



@app.post("/create-invoice")

async def create_invoice(payload: InvoiceRequest, x_api_key: str = Header(None)):

    if x_api_key != API_KEY:

        raise HTTPException(status_code=401, detail="Неверный X-Api-Key")



    conn = get_db()

    active_row = conn.execute("SELECT * FROM accounts WHERE is_active = 1 LIMIT 1").fetchone()

    if not active_row:

        conn.close()

        raise HTTPException(status_code=400, detail="Нет активного аккаунта! Добавьте его в панели.")



    token = active_row["token"]

    account_alias = active_row["alias"]

    client_phone = re.sub(r"\D", "", payload.client_phone or "")



    fns_payload = {

        "acquirerId": 833,

        "clientName": payload.client_name,

        "clientPhone": client_phone,

        "clientEmail": payload.client_email,

        "clientType": "FROM_INDIVIDUAL",

        "services": [{"name": payload.name, "amount": payload.amount, "quantity": 1, "serviceNumber": 0}],

        "totalAmount": str(payload.amount),

        "type": "ACQUIRER"

    }



    fns_headers = {

        "Authorization": f"Bearer {token}",

        "Content-Type": "application/json",

        "Accept": "application/json, text/plain, */*",

        "Referer": "https://lknpd.nalog.ru/sales",

        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"

    }



    async with httpx.AsyncClient(timeout=30.0) as client:

        res_fns = await client.post("https://lknpd.nalog.ru/api/v1/invoice", json=fns_payload, headers=fns_headers)

        if res_fns.status_code == 401:

            conn.close()

            raise HTTPException(status_code=401, detail="Токен ФНС истёк! Обновите его.")

        if res_fns.status_code != 200:

            conn.close()

            raise HTTPException(status_code=res_fns.status_code, detail=f"Ошибка ФНС: {res_fns.text}")



        data_fns = res_fns.json()

        payment_url = data_fns.get("paymentUrl")

        invoice_id = data_fns.get("invoiceId")

        uuid = payment_url.rstrip("/").split("/")[-1]



        mobi_headers = {

            "Accept": "application/json, text/plain, */*",

            "Origin": "https://smzoplata.ru",

            "Referer": "https://smzoplata.ru/fns/",

            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"

        }



        res_data = await client.get(

            f"https://fns-service-api.smzoplata.ru/invoice/{uuid}/payment_data",

            headers=mobi_headers

        )

        if res_data.status_code != 200:

            conn.close()

            raise HTTPException(status_code=res_data.status_code, detail=f"Ошибка payment_data: {res_data.text}")



        signature = res_data.json().get("signature")



        sbp_payload = {

            "amount": payload.amount,

            "internal_invoice_id": uuid,

            "email": payload.client_email,

            "phone": None,

            "signature": signature,

            "status": "NEW"

        }



        res_sbp = await client.post(

            "https://fns-service-api.smzoplata.ru/payment/sbp",

            json=sbp_payload,

            headers=mobi_headers

        )

        if res_sbp.status_code not in (200, 201):

            conn.close()

            raise HTTPException(status_code=res_sbp.status_code, detail=f"Ошибка СБП: {res_sbp.text}")



        sbp_url = res_sbp.json().get("sbp_url")



        qr = qrcode.QRCode(box_size=7, border=2)

        qr.add_data(sbp_url)

        qr.make(fit=True)

        img = qr.make_image(fill_color="black", back_color="white")

        buffer = io.BytesIO()

        img.save(buffer, format="PNG")

        qr_b64 = "data:image/png;base64," + base64.b64encode(buffer.getvalue()).decode()



        conn.execute(

            "INSERT INTO invoices (invoice_id, date, name, amount, email, account_alias, is_paid, sbp_url) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",

            (invoice_id, datetime.now().strftime("%d.%m %H:%M"), payload.name, payload.amount, payload.client_email, account_alias, 0, sbp_url)

        )

        conn.commit()

        conn.close()



        return {

            "status": "ok",

            "invoice_id": invoice_id,

            "sbp_url": sbp_url,

            "qr_base64": qr_b64

        }

