        <div id="tokList" style="margin:12px 0;"></div>

        

        <details>

          <summary style="cursor:pointer; color:var(--primary); font-size:13px; font-weight:600;">+ Добавить аккаунт</summary>

          <div class="field" style="margin-top:10px;"><label>Название / Алиас</label><input type="text" id="tAlias" placeholder="Например: ИП Иванов"></div>

          <div class="field"><label>Bearer Токен</label><textarea id="tVal" rows="4" placeholder="Вставьте токен eyJ..."></textarea></div>

          <div style="display:flex; gap:10px; margin-top:8px;">

            <button class="btn btn-sm btn-check" style="flex:1; padding:10px;" type="button" id="rawCheckBtn" onclick="checkRawToken()">Проверить токен</button>

            <button class="btn btn-sm" style="flex:1; background:var(--ok); padding:10px;" type="button" id="saveTokBtn" onclick="addTok()">Сохранить</button>

          </div>

          <div id="tokCheckResult" style="font-size:12px; margin-top:10px; display:none; padding:10px; border-radius:6px; word-break:break-all;"></div>

        </details>

      </div>

      <div class="card">

        <h3 style="margin-bottom:14px;">История операций</h3>

        <table><thead><tr><th>Дата</th><th>Счёт</th><th>Услуга</th><th>Сумма</th><th>Статус</th></tr></thead><tbody id="histBody"></tbody></table>

      </div>

    </div>

  </div>



  <!-- ВКЛАДКА 2: МАНУАЛ -->

  <div id="viewManual" class="view-content hidden">

    <div class="manual-layout">

      <div class="card">

        <h3 id="noteFormTitle" style="margin-bottom:14px;">Новая запись</h3>

        <input type="hidden" id="editNoteId" value="">

        <div class="field">

          <label>Топик / Категория</label>

          <input type="text" id="noteTopic" placeholder="Например: Инструкции, Скрипты">

        </div>

        <div class="field">

          <label>Заголовок</label>

          <input type="text" id="noteTitle" placeholder="Суть заметки">

        </div>

        <div class="field">

          <label>Текст заметки</label>

          <textarea id="noteContent" rows="8" placeholder="Инструкции, данные, команды..."></textarea>

        </div>

        <button class="btn" id="saveNoteBtn" type="button" onclick="saveNote()">Сохранить заметку</button>

        <button class="btn btn-sm btn-sel hidden" id="cancelEditBtn" type="button" onclick="cancelEdit()" style="margin-top:8px; width:100%;">Отменить редактирование</button>

      </div>



      <div class="card">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">

          <h3>База знаний</h3>

          <input type="text" id="searchNotes" onkeyup="filterNotes()" placeholder="Поиск..." style="width:200px; padding:6px 10px; font-size:13px;">

        </div>

        <div id="notesContainer">Загрузка заметок...</div>

      </div>

    </div>

  </div>



  <script>

    const getTok = function() { return localStorage.getItem('hub_session') || ''; };

    

    // Передаем токен сразу всеми путями: и через Header, и через Query param

    const authUrl = function(path) {

      const t = encodeURIComponent(getTok());

      return path + (path.indexOf('?') === -1 ? '?auth=' : '&auth=') + t;

    };



    const getHeaders = function() {

      return {

        'Authorization': 'Bearer ' + getTok(),

        'Content-Type': 'application/json'

      };

    };



    let allNotes = [];



    function logout() {

      localStorage.removeItem('hub_session');

      window.location.replace('/');

    }



    function checkAuth(res) {

      if (res && res.status === 401) {

        alert('Сессия не найдена или истекла. Выполните вход.');

        logout();

        return false;

      }

      return true;

    }



    function switchTab(tab) {

      const btnTerm = document.getElementById('tabTerminalBtn');

      const btnMan = document.getElementById('tabManualBtn');

      const viewTerm = document.getElementById('viewTerminal');

      const viewMan = document.getElementById('viewManual');



      if (tab === 'terminal') {

        btnTerm.classList.add('active');

        btnMan.classList.remove('active');

        viewTerm.classList.remove('hidden');

        viewMan.classList.add('hidden');

      } else {

        btnTerm.classList.remove('active');

        btnMan.classList.add('active');

        viewTerm.classList.add('hidden');

        viewMan.classList.remove('hidden');

        loadNotes();

      }

    }



    async function loadAll() {

      if (!getTok()) { logout(); return; }



      try {

        const r1 = await fetch(authUrl('/api/tokens'), { headers: getHeaders() });

        if (!checkAuth(r1)) return;

        const d1 = await r1.json();

        

        const tokList = document.getElementById('tokList');

        tokList.innerHTML = '';

        let act = 'Не выбран';

        

        (d1.tokens || []).forEach(function(t) {

          if (t.is_active) act = t.alias;

          

          let btnAct = t.is_active 

            ? '<span class="status-badge badge-ok">Активен</span>' 

            : '<button class="btn-sm btn-sel" onclick="selTok(\\'' + t.id + '\\')">Выбрать</button>';

            

          let expInfo = t.is_expired ? '<span style="color:var(--err);font-size:11px;"> (Истёк)</span>' : '';



          let div = document.createElement('div');

          div.className = 'token-item ' + (t.is_active ? 'active' : '');

          div.innerHTML = 

            '<div class="token-header">' +

              '<div><b>' + t.alias + '</b>' + expInfo + '<div style="font-size:11px;color:var(--muted);">' + t.phone + ' | До: ' + t.exp_date + '</div></div>' +

              '<div>' + btnAct + ' <button class="btn-sm btn-del" onclick="delTok(\\'' + t.id + '\\')">✕</button></div>' +

            '</div>' +

            '<div class="token-actions">' +

              '<button class="btn-sm btn-check" onclick="checkSavedToken(\\'' + t.id + '\\', this)">Проверить статус</button>' +

              '<span id="st_' + t.id + '" style="font-size:11px; font-weight:600;"></span>' +

            '</div>';

          tokList.appendChild(div);

        });



        document.getElementById('curAcc').innerText = 'Аккаунт: ' + act;



        const r2 = await fetch(authUrl('/api/history'), { headers: getHeaders() });

        if (!r2.ok) return;

        const d2 = await r2.json();

        const histBody = document.getElementById('histBody');

        histBody.innerHTML = '';

        (d2.history || []).forEach(function(i) {

          histBody.innerHTML += '<tr><td>' + i.date + '</td><td>#' + i.invoice_id + '</td><td>' + i.name + '</td><td><b>' + i.amount + ' ₽</b></td><td>' + (i.is_paid ? '✔ Оплачен' : '⏳ Ожидает') + '</td></tr>';

        });

      } catch(e) {

        console.error(e);

      }

    }



    async function checkSavedToken(id, btn) {

      const label = document.getElementById('st_' + id);

      btn.disabled = true;

      label.innerText = 'Проверка...';

      label.style.color = 'var(--muted)';

      try {

        const res = await fetch(authUrl('/api/tokens/check/' + id), { headers: getHeaders() });

        if (!checkAuth(res)) return;

        const d = await res.json();

        if (d.status === 'ok') {

          label.innerText = '✔ ' + d.detail;

          label.style.color = 'var(--ok)';

        } else {

          label.innerText = '✖ ' + d.detail;

          label.style.color = 'var(--err)';

        }

      } catch(e) {

        label.innerText = '✖ Ошибка';

        label.style.color = 'var(--err)';

      } finally {

        btn.disabled = false;

      }

    }



    async function checkRawToken() {

      const btn = document.getElementById('rawCheckBtn');

      const box = document.getElementById('tokCheckResult');

      let val = document.getElementById('tVal').value.trim();

      val = val.replace(/^Bearer\s+/i, '').replace(/[\\r\\n\\s]+/g, '');

      

      if (!val) { alert('Вставьте токен в поле!'); return; }



      btn.disabled = true;

      box.style.display = 'block';

      box.style.background = 'rgba(59,130,246,0.15)';

      box.style.color = '#60a5fa';

      box.innerText = 'Проверка формата и срока действия...';



      try {

        const res = await fetch(authUrl('/api/tokens/check-raw'), {

          method: 'POST',

          headers: getHeaders(),

          body: JSON.stringify({ token: val, auth_token: getTok() })

        });

        if (!checkAuth(res)) return;

        const d = await res.json();

        if (d.status === 'ok') {

          box.style.background = 'rgba(16,185,129,0.15)';

          box.style.color = 'var(--ok)';

          box.innerText = '✔ ' + d.detail;

        } else {

          box.style.background = 'rgba(239,68,68,0.15)';

          box.style.color = 'var(--err)';

          box.innerText = '✖ ' + d.detail;

        }

      } catch(e) {

        box.style.background = 'rgba(239,68,68,0.15)';

        box.style.color = 'var(--err)';

        box.innerText = '✖ Ошибка проверки';

      } finally {

        btn.disabled = false;

      }

    }



    async function addTok() {

      const btn = document.getElementById('saveTokBtn');

      const alias = document.getElementById('tAlias').value.trim();

      let token = document.getElementById('tVal').value.trim();

      token = token.replace(/^Bearer\s+/i, '').replace(/[\\r\\n\\s]+/g, '');



      if (!token) {

        alert('Поле токена не должно быть пустым!');

        return;

      }



      btn.disabled = true;

      btn.innerText = 'Сохранение...';



      try {

        const res = await fetch(authUrl('/api/tokens/add'), {

          method: 'POST',

          headers: getHeaders(),

          body: JSON.stringify({ alias: alias, token: token, auth_token: getTok() })

        });



        if (!checkAuth(res)) return;

        const d = await res.json();

        if (!res.ok) throw new Error(d.detail || 'Ошибка сохранения');



        document.getElementById('tAlias').value = '';

        document.getElementById('tVal').value = '';

        document.getElementById('tokCheckResult').style.display = 'none';

        alert('Токен успешно сохранён!');

        await loadAll();

      } catch(err) {

        alert('Ошибка: ' + err.message);

      } finally {

        btn.disabled = false;

        btn.innerText = 'Сохранить';

      }

    }



    async function selTok(id) {

      const res = await fetch(authUrl('/api/tokens/set-active'), { 

        method: 'POST', 

        headers: getHeaders(), 

        body: JSON.stringify({ token_id: id, auth_token: getTok() }) 

      });

      if (!checkAuth(res)) return;

      loadAll();

    }



    async function delTok(id) {

      if (!confirm('Удалить этот аккаунт?')) return;

      const res = await fetch(authUrl('/api/tokens/' + id), { method: 'DELETE', headers: getHeaders() });

      if (!checkAuth(res)) return;

      loadAll();

    }



    document.getElementById('invForm').onsubmit = async function(e) {

      e.preventDefault();

      const btn = document.getElementById('iBtn');

      btn.disabled = true;

      try {

        const res = await fetch(authUrl('/create-invoice'), {

          method: 'POST',

          headers: getHeaders(),

          body: JSON.stringify({

            name: document.getElementById('iName').value,

            amount: parseFloat(document.getElementById('iAmt').value),

            client_email: document.getElementById('iMail').value,

            client_phone: document.getElementById('iPh').value,

            auth_token: getTok()

          })

        });

        if (!checkAuth(res)) return;

        const d = await res.json();

        if (!res.ok) throw new Error(d.detail);

        document.getElementById('qrImg').src = d.qr_base64;

        document.getElementById('qrLnk').href = d.sbp_url;

        document.getElementById('qrRes').style.display = 'block';

        loadAll();

      } catch(ex) {

        alert('Ошибка: ' + ex.message);

      } finally {

        btn.disabled = false;

      }

    };



    // --- Мануал ---

    async function loadNotes() {

      const c = document.getElementById('notesContainer');

      try {

        const res = await fetch(authUrl('/api/manual'), { headers: getHeaders() });

        if (!checkAuth(res)) return;

        allNotes = await res.json();

        renderNotes(allNotes);

      } catch(e) {

        c.innerHTML = '<div style="color:var(--err);">Ошибка загрузки заметок</div>';

      }

    }



    function renderNotes(notes) {

      const c = document.getElementById('notesContainer');

      if (!notes || !notes.length) {

        c.innerHTML = '<div style="color:var(--muted); font-size:13px; text-align:center; padding:20px;">Заметок пока нет. Добавьте первую!</div>';

        return;

      }

      let html = '';

      notes.forEach(function(n) {

        html += 

          '<div class="note-card">' +

            '<span class="topic-badge">' + escapeHtml(n.topic) + '</span>' +

            '<h4>' + escapeHtml(n.title) + '</h4>' +

            '<p>' + escapeHtml(n.content) + '</p>' +

            '<div style="font-size:11px; color:var(--muted); margin-top:8px;">Обновлено: ' + n.updated_at + '</div>' +

            '<div class="note-actions">' +

              '<button class="btn-sm btn-sel" onclick="startEditNote(' + n.id + ')">Редактировать</button>' +

              '<button class="btn-sm btn-del" onclick="deleteNote(' + n.id + ')">Удалить</button>' +

            '</div>' +

          '</div>';

      });

      c.innerHTML = html;

    }



    function escapeHtml(text) {

      if (!text) return '';

      return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    }



    function filterNotes() {

      const q = document.getElementById('searchNotes').value.toLowerCase();

      const filtered = allNotes.filter(function(n) {

        return (n.topic && n.topic.toLowerCase().indexOf(q) !== -1) ||

               (n.title && n.title.toLowerCase().indexOf(q) !== -1) ||

               (n.content && n.content.toLowerCase().indexOf(q) !== -1);

      });

      renderNotes(filtered);

    }



    async function saveNote() {

      const btn = document.getElementById('saveNoteBtn');

      const id = document.getElementById('editNoteId').value;

      const topic = document.getElementById('noteTopic').value.trim();

      const title = document.getElementById('noteTitle').value.trim();

      const content = document.getElementById('noteContent').value.trim();



      if (!topic || !title || !content) {

        alert('Заполните все поля: категорию, заголовок и текст!');

        return;

      }



      btn.disabled = true;

      btn.innerText = 'Сохранение...';



      try {

        let res;

        if (id) {

          res = await fetch(authUrl('/api/manual/update'), {

            method: 'POST',

            headers: getHeaders(),

            body: JSON.stringify({ id: parseInt(id), topic: topic, title: title, content: content, auth_token: getTok() })

          });

        } else {

          res = await fetch(authUrl('/api/manual/add'), {

            method: 'POST',

            headers: getHeaders(),

            body: JSON.stringify({ topic: topic, title: title, content: content, auth_token: getTok() })

          });

        }



        if (!checkAuth(res)) return;

        const d = await res.json();

        if (!res.ok) throw new Error(d.detail || 'Ошибка сохранения');



        cancelEdit();

        await loadNotes();

      } catch(err) {

        alert(err.message);

      } finally {

        btn.disabled = false;

        btn.innerText = id ? 'Сохранить изменения' : 'Сохранить заметку';

      }

    }



    function startEditNote(id) {

      const note = allNotes.find(function(n) { return n.id === id; });

      if (!note) return;

      document.getElementById('editNoteId').value = note.id;

      document.getElementById('noteTopic').value = note.topic;

      document.getElementById('noteTitle').value = note.title;

      document.getElementById('noteContent').value = note.content;

      document.getElementById('noteFormTitle').innerText = 'Редактировать запись';

      document.getElementById('saveNoteBtn').innerText = 'Сохранить изменения';

      document.getElementById('cancelEditBtn').classList.remove('hidden');

    }



    function cancelEdit() {

      document.getElementById('editNoteId').value = '';

      document.getElementById('noteTopic').value = '';

      document.getElementById('noteTitle').value = '';

      document.getElementById('noteContent').value = '';

      document.getElementById('noteFormTitle').innerText = 'Новая запись';

      document.getElementById('saveNoteBtn').innerText = 'Сохранить заметку';

      document.getElementById('cancelEditBtn').classList.add('hidden');

    }



    async function deleteNote(id) {

      if (!confirm('Удалить эту заметку?')) return;

      const res = await fetch(authUrl('/api/manual/' + id), { method: 'DELETE', headers: getHeaders() });

      if (!checkAuth(res)) return;

      loadNotes();

    }



    loadAll();

  </script>

</body>

</html>"""



def inspect_token(token_str: str) -> dict:

    raw = token_str.replace("Bearer ", "").replace("\n", "").replace("\r", "").strip()

    if not raw:

        return {"status": "error", "detail": "Токен пуст"}

    

    jwt_data = parse_jwt(raw)

    if not jwt_data:

        return {"status": "error", "detail": "Некорректный формат JWT (ожидалось 3 блока через точку)"}

    

    exp = jwt_data.get("exp", 0)

    phone = "-"

    try:

        phone = json.loads(jwt_data.get("sub", "{}")).get("login", "-")

    except:

        pass



    now = time.time()

    if exp and now > exp:

        exp_dt = datetime.fromtimestamp(exp).strftime("%d.%m.%Y %H:%M")

        return {"status": "error", "detail": f"Токен истёк {exp_dt}"}

    

    exp_dt = datetime.fromtimestamp(exp).strftime("%d.%m.%Y %H:%M") if exp else "бессрочно"

    return {

        "status": "ok",

        "detail": f"Активен | Телефон: +{phone} | Годен до: {exp_dt}",

        "phone": phone

    }



@app.get("/api/tokens/check/{tid}")

async def check_token_by_id(tid: str, req: Request):

    verify_request(req)

    conn = get_db()

    row = conn.execute("SELECT token FROM accounts WHERE id = ?", (tid,)).fetchone()

    conn.close()

    if not row:

        raise HTTPException(status_code=404, detail="Аккаунт не найден")

    return inspect_token(row["token"])



@app.post("/api/tokens/check-raw")

async def check_token_raw(p: CheckTokenModel, req: Request):

    token = p.auth_token or get_req_auth(req)

    if not check_token_auth(token):

        raise HTTPException(status_code=401, detail="Unauthorized")

    return inspect_token(p.token)



@app.get("/api/manual")

async def get_manual_notes(req: Request):

    verify_request(req)

    conn = get_db()

    rows = conn.execute("SELECT * FROM manual_notes ORDER BY id DESC").fetchall()

    conn.close()

    return [{"id": r["id"], "topic": r["topic"], "title": r["title"], "content": r["content"], "updated_at": r["updated_at"]} for r in rows]



@app.post("/api/manual/add")

async def add_manual_note(p: ManualNoteModel, req: Request):

    token = p.auth_token or get_req_auth(req)

    if not check_token_auth(token):

        raise HTTPException(status_code=401, detail="Unauthorized")

    conn = get_db()

    conn.execute(

        "INSERT INTO manual_notes (topic, title, content, updated_at) VALUES (?, ?, ?, ?)",

        (p.topic.strip(), p.title.strip(), p.content.strip(), datetime.now().strftime("%d.%m.%Y %H:%M"))

    )

    conn.commit()

    conn.close()

    return {"status": "ok"}



@app.post("/api/manual/update")

async def update_manual_note(p: ManualNoteUpdateModel, req: Request):

    token = p.auth_token or get_req_auth(req)

    if not check_token_auth(token):

        raise HTTPException(status_code=401, detail="Unauthorized")

    conn = get_db()

    conn.execute(

        "UPDATE manual_notes SET topic = ?, title = ?, content = ?, updated_at = ? WHERE id = ?",

        (p.topic.strip(), p.title.strip(), p.content.strip(), datetime.now().strftime("%d.%m.%Y %H:%M"), p.id)

    )

