#1788561004
python3 - << 'EOF'

path = "/home/c/cc361963/public_html/app.py"

with open(path, "r", encoding="utf-8", errors="ignore") as f:

    lines = f.readlines()



new_lines = []

skip = False

for line in lines:

    # Заменяем сломанные конструкции replace("Bearer ", "").replace(

    if 'replace("Bearer ", "").replace(' in line or "replace('Bearer ', '').replace(" in line:

        indent = len(line) - len(line.lstrip())

        var_name = line.split("=")[0].strip()

        source_var = line.split(".replace")[0].split("=")[1].strip()

        new_lines.append(" " * indent + f"{var_name} = ''.join(({source_var} or '').split()).replace('Bearer', '').strip()\n")

        skip = True

        continue

    if skip:

        # Пропускаем оторванные хвосты кавычек

        if line.strip().startswith('")') or line.strip().startswith("')") or line.strip() == '"' or line.strip() == "'":

            skip = False

            continue

        if any(w in line for w in ["jwt = ", "conn = ", "ref_clean = ", "if not "]):

            skip = False

        else:

            continue

    new_lines.append(line)



with open(path, "w", encoding="utf-8") as f:

    f.writelines(new_lines)



print("Все вызовы очистки токенов исправлены!")

EOF

