# Вырезаем старую функцию между объявлением и следующей функцией

if "function clientCheckToken()" in content and "async function openProfile" in content:

    before = content.split("function clientCheckToken()")[0]

    after = "async function openProfile" + content.split("async function openProfile")[1]

    content = before + new_func + "\n\n    " + after



    with open(path, "w", encoding="utf-8") as f:

        f.write(content)

    print("dashboard.html успешно обновлён без регулярных выражений!")

else:

