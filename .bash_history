    # 1. Проверка логина и пароля

    if p.login != AUTH_LOGIN or p.password != AUTH_PASS:

        raise HTTPException(status_code=400, detail="Неверный логин или пароль")



    # 2. Строгая проверка формата 2FA

    code = p.code_2fa.strip()

    if len(code) != 6 or not code.isdigit():

        raise HTTPException(status_code=400, detail="Код 2FA должен состоять строго из 6 цифр")



    # 3. Проверка TOTP по секрету

    totp = pyotp.TOTP(AUTH_2FA_SECRET)

    if not totp.verify(code, valid_window=1):

        raise HTTPException(status_code=400, detail="Неверный 2FA код")



    # 4. Выдача токена только при 100% успехе

    new_token = secrets.token_hex(32)

    ACTIVE_SESSIONS.add(new_token)

    return {"status": "ok", "token": new_token}



@app.post("/api/logout")

async def logout(req: Request):

    t = req.headers.get("Authorization", "").replace("Bearer ", "").strip()

    ACTIVE_SESSIONS.discard(t)

    return {"status": "ok"}



@app.get("/api/tokens")

async def get_tokens(req: Request):

    check_auth(req)

    conn = get_db()

    rows = conn.execute("SELECT * FROM accounts ORDER BY created_at DESC").fetchall()

    conn.close()

    active_id = None

    res = []

    for r in rows:

        if r["is_active"]: active_id = r["id"]

        jwt = parse_jwt(r["token"])

        exp = jwt.get("exp", 0)

        res.append({

            "id": r["id"], "alias": r["alias"], "phone": r["phone"] or "-",

            "is_active": bool(r["is_active"]), "is_expired": time.time() > exp if exp else False,

            "exp_date": datetime.fromtimestamp(exp).strftime("%d.%m.%Y %H:%M") if exp else "-"

        })

    return {"active_id": active_id, "tokens": res}



@app.post("/api/tokens/add")

async def add_tok(p: AddTokenModel, req: Request):

    check_auth(req)

    raw = p.token.replace("Bearer ", "").strip()

    if not raw: raise HTTPException(status_code=400, detail="Токен пуст")

    jwt = parse_jwt(raw)

    phone = "-"

    try: phone = json.loads(jwt.get("sub", "{}")).get("login", "-")

    except: pass

    tid = f"acc_{int(time.time()*1000)}"

    conn = get_db()

    cnt = conn.execute("SELECT COUNT(*) FROM accounts").fetchone()[0]

    conn.execute("INSERT INTO accounts VALUES (?, ?, ?, ?, ?, ?)", (tid, p.alias or f"Аккаунт +{phone}", phone, raw, 1 if cnt==0 else 0, datetime.now().isoformat()))

    conn.commit()

    conn.close()

    return {"status": "ok"}



@app.post("/api/tokens/set-active")

async def set_active(p: ActiveModel, req: Request):

    check_auth(req)

    conn = get_db()

    conn.execute("UPDATE accounts SET is_active = 0")

    conn.execute("UPDATE accounts SET is_active = 1 WHERE id = ?", (p.token_id,))

    conn.commit()

    conn.close()

    return {"status": "ok"}



@app.delete("/api/tokens/{tid}")

async def del_tok(tid: str, req: Request):

    check_auth(req)

    conn = get_db()

    cur = conn.execute("SELECT is_active FROM accounts WHERE id = ?", (tid,)).fetchone()

    conn.execute("DELETE FROM accounts WHERE id = ?", (tid,))

    if cur and cur["is_active"]:

        first = conn.execute("SELECT id FROM accounts LIMIT 1").fetchone()

        if first: conn.execute("UPDATE accounts SET is_active = 1 WHERE id = ?", (first["id"],))

    conn.commit()

    conn.close()

    return {"status": "ok"}



@app.get("/api/history")

async def history(req: Request):

